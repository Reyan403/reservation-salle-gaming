									<div class="text-center text-xs font-medium text-zinc-500 py-2">Fr</div>
									<div class="text-center text-xs font-medium text-zinc-500 py-2">Sa</div>

									<!-- Empty cells for offset -->
									{% set firstDayOfMonth = 'first day of this month'|date('w') %}
									{% for i in 1..firstDayOfMonth %}
										<div></div>
									{% endfor %}

									<!-- Days -->
									{% set today = 'now'|date('j') %}
